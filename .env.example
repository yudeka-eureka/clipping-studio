# ==========================================
# Database Configuration (MariaDB / MySQL)
# ==========================================
DB_ROOT_PASSWORD=ganti_dengan_root_password_yang_kuat
DB_NAME=clipping_studio
DB_USER=clipping_user
DB_PASSWORD=ganti_dengan_password_user_yang_kuat

# ==========================================
# Backend & AI Configuration
# ==========================================
# Mode publik (false jika menggunakan API key lokal dari .env, true jika multi-user memasukkan API key sendiri via web)
PUBLIC_MODE=false

# Provider AI default (gemini, openai, anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Batasan Rate Limit & Timeout
JOB_RATE_LIMIT=5
JOB_RATE_WINDOW_SECONDS=3600
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_RENDERS=1
EXECUTION_TIMEOUT_MINUTES=60
AI_TIMEOUT_MINUTES=60
JOB_RETENTION_HOURS=24

# Hosting Media (opsional: cloudinary / r2)
MEDIA_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
