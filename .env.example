# true untuk deployment publik: API key AI disimpan di browser dan dikirim per request
PUBLIC_MODE=false
# Batas job baru per sesi dalam satu window (aktif di PUBLIC_MODE)
JOB_RATE_LIMIT=5
JOB_RATE_WINDOW_SECONDS=3600
# Maksimum job/pipeline dan render berat yang berjalan bersamaan
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_RENDERS=1

# Hosting video publik: cloudinary atau r2
MEDIA_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Keamanan & Kuota Unduhan URL
# MAX_FILESIZE_MB=500
# MAX_DURATION_MINUTES=45
# ALLOWED_DOMAINS=

# Pembersihan Otomatis Berbasis Waktu (TTL / Retention)
JOB_RETENTION_HOURS=24

# Supabase Server (User & Credential Token)
SUPABASE_URL=https://your-project.supabase.co
# Backend serverless menggunakan Secret Key (atau Service Role Key) agar melewati RLS secara aman:
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Alias yang juga didukung: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET
