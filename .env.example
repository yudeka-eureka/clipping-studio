# Penyedia AI pemilih klip: gemini | anthropic | openai
AI_PROVIDER=gemini
# true untuk deployment publik: API key AI disimpan di browser dan dikirim per request
PUBLIC_MODE=false
# Batas job baru per sesi dalam satu window (aktif di PUBLIC_MODE)
JOB_RATE_LIMIT=5
JOB_RATE_WINDOW_SECONDS=3600
# Maksimum job/pipeline dan render berat yang berjalan bersamaan
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_RENDERS=1

# Buat API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Gemini yang dipakai (bisa diganti dari menu Pengaturan)
GEMINI_MODEL=gemini-2.5-flash
# Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Posting via Buffer (https://publish.buffer.com/settings/api)
BUFFER_API_KEY=
# Hosting video publik: cloudinary atau r2
MEDIA_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Keamanan & Kuota Unduhan URL
# MAX_FILESIZE_MB=500
# MAX_DURATION_MINUTES=45
# ALLOWED_DOMAINS=
