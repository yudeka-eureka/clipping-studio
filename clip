#!/usr/bin/env bash
# Clipping Studio dari command line. Contoh: ./clip run podcast.mp4 --json
set -e
# Redam log bawaan MediaPipe/TensorFlow Lite.
export GLOG_minloglevel=2 TF_CPP_MIN_LOG_LEVEL=3 GRPC_VERBOSITY=ERROR
cd "$(dirname "$0")"
if [ ! -x .venv/bin/python ]; then
  echo "Menyiapkan environment Python (sekali saja)…" >&2
  if command -v uv >/dev/null; then uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r requirements.txt
  else python3 -m venv .venv && .venv/bin/pip install -r requirements.txt; fi
fi
exec .venv/bin/python -m app.cli "$@"
